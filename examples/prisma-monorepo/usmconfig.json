{
  "$schema": "https://usm.dev/schema/usmconfig-v1.json",
  "version": "1",
  "name": "prisma-monorepo",
  "sources": {
    "root": ".",
    "include": [
      "apps/*",
      "packages/*"
    ],
    "exclude": [
      "**/node_modules/**",
      "**/dist/**",
      "**/.next/**",
      "**/build/**"
    ],
    "package_manifests": [
      "**/package.json"
    ],
    "code_globs": [
      "**/*.ts",
      "**/*.tsx",
      "**/*.js"
    ]
  },
  "shared": [
    {
      "id": "@my-org/db",
      "match": "packages/db",
      "kind": "orm",
      "summary": "@my-org/db — orm shared package"
    }
  ],
  "services": [
    {
      "match": "apps/web",
      "kind": "web-app",
      "summary": "@my-org/web — web-app service"
    }
  ],
  "data": [
    {
      "match": "packages/db/prisma/schema.prisma",
      "kind": "prisma",
      "extract": {
        "models": true,
        "relations": false,
        "enums": false
      }
    }
  ],
  "outputs": {
    "usm_source": ".usm/",
    "design_docs": "docs/design/",
    "help_docs": "docs/help/",
    "api_docs": "docs/api/",
    "agent_context": ".usm-workspace/",
    "tests": "tests/auto-generated/",
    "diagrams": "docs/diagrams/"
  },
  "generation": {
    "merge_with_existing": "smart",
    "preserve_comments": true,
    "format": "github-flavored-markdown"
  }
}