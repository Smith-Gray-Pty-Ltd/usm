$schema: https://usm.dev/schema/v1.json
$id: usm/mcp-read
$type: feature
$version: 1
$last_updated: "2026-09-27"
summary: >-
  MCP read tool — reads and parses a .usm file, returning the full object plus metadata (id, type,
  version, summary, type-specific counts).
$system: usm/system
$service: usm/mcp
command: usm_read
intent: >
  Agents need to read the full content of a specific .usm file to understand a service, feature, or
  system. The read tool parses the file and returns both the complete data and extracted metadata
  for quick agent scanning.
flows:
  - id: read-file
    name: Read pipeline (file access)
    description: "System pipeline behind usm_read: locate, parse, and return a .usm file with metadata."
    steps:
      - actor: agent
        id: s1
        action: get
        target: file path
      - actor: agent
        id: s2
        action: parse
        target: YAML content into typed object
      - actor: agent
        id: s3
        action: observe
        target: metadata (type-specific counts for features/flows/contracts/tests)
  - description: >-
      The spec-first handoff: a spec author assigns a task, and the agent grounds its implementation
      in the governing spec via MCP read before touching code.
    id: grounded-implementation
    name: Ground implementation in the governing spec
    steps:
      - actor: spec-author
        id: s1
        action: assign
        surface: chat
        target: implementation work on a feature
      - actor: agent
        id: s2
        action: read
        surface: api
        target: the governing .usm spec via usm_read before editing any code
      - actor: agent
        id: s3
        action: check
        surface: api
        target: the spec's contracts as acceptance criteria and existing flows for context
      - actor: spec-author
        id: s4
        action: review
        surface: chat
        target: the agent's summary of what the spec requires before implementation proceeds
contracts:
  - id: read-returns-full-data
    description: Read must return both the full parsed object and metadata
    must_have:
      - Metadata includes id, type, version, summary
      - System files include featureCount, serviceCount
      - Feature files include flowCount, contractCount, testCount
tests:
  - id: read-feature-file
    setup:
      valid_feature_usm: true
    expect:
      - assertion: response includes full parsed data
      - assertion: metadata includes flowCount, contractCount, testCount
implementation:
  primary: src/mcp/read.ts
  test_code: ""
  test_code_status: none
see_also:
  - usm/mcp
